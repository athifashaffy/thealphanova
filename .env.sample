# The Alpha Nova — template for .env. Copy to `.env` and fill in.
#
#   cp .env.sample .env
#
# .env is gitignored and must stay that way: this repository is public, and a
# hardcoded secret is exactly how the previous reCAPTCHA key was exposed.
# .htaccess also blocks it from being served over HTTP.
#
# Get a v3 key pair at https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
